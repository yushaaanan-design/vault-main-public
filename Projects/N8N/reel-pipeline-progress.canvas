		{"id":"0000000000000033","type":"text","text":"**ffmpeg**\nextract audio → .mp3","x":710,"y":390,"width":220,"height":100,"color":"5"},
		{"id":"0000000000000034","type":"text","text":"**whisper.cpp**\ntranscribe (self-hosted, not API)","x":960,"y":390,"width":220,"height":100,"color":"5"},
		{"id":"0000000000000036","type":"text","text":"**Code node**\nbuild multimodal prompt","x":210,"y":510,"width":220,"height":100,"color":"5"},
