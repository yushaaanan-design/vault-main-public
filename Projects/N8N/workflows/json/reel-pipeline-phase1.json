{
  "name": "Reel to Knowledge Pipeline",
  "nodes": [
    {
      "parameters": { "updates": ["message"] },
      "id": "n1", "name": "Telegram Trigger", "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1, "position": [-200, 0], "webhookId": "reel-trigger",
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [{
            "leftValue": "={{ $json.message.video }}",
            "rightValue": "", "operator": { "type": "object", "operation": "exists" }
          }],
          "combinator": "and"
        }
      },
      "id": "n2", "name": "IF has video", "type": "n8n-nodes-base.if",
      "typeVersion": 2, "position": [40, 0]
    },
    {
      "parameters": {
        "resource": "message", "operation": "sendMessage",
        "chatId": "={{ $json.message.chat.id }}",
        "text": "Send a reel (video), not text."
      },
      "id": "n3", "name": "Reply - send a reel", "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2, "position": [280, 150],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot{{ $credentials.telegramApi.accessToken }}/getFile?file_id={{ $json.message.video.file_id }}"
      },
      "id": "n4", "name": "Telegram getFile", "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2, "position": [280, -100],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "command": "=yt-dlp -o /tmp/reels/{{ $('IF has video').item.json.message.video.file_id }}.mp4 \"https://api.telegram.org/file/bot{{ $credentials.telegramApi.accessToken }}/{{ $json.result.file_path }}\""
      },
      "id": "n5", "name": "yt-dlp download", "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1, "position": [520, -100]
    },
    {
      "parameters": {
        "command": "=ffmpeg -y -i /tmp/reels/{{ $('IF has video').item.json.message.video.file_id }}.mp4 /tmp/reels/{{ $('IF has video').item.json.message.video.file_id }}.mp3"
      },
      "id": "n6", "name": "ffmpeg extract audio", "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1, "position": [760, -100]
    },
    {
      "parameters": {
        "command": "=whisper.cpp/main -m whisper.cpp/models/ggml-base.en.bin -f /tmp/reels/{{ $('IF has video').item.json.message.video.file_id }}.mp3 -otxt -of /tmp/reels/{{ $('IF has video').item.json.message.video.file_id }}"
      },
      "id": "n7", "name": "whisper.cpp transcribe", "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1, "position": [1000, -100]
    },
    {
      "parameters": {
        "command": "=ffmpeg -y -i /tmp/reels/{{ $('IF has video').item.json.message.video.file_id }}.mp4 -vf fps=1/3 /tmp/reels/{{ $('IF has video').item.json.message.video.file_id }}_f%d.jpg"
      },
      "id": "n8", "name": "ffmpeg extract frames", "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1, "position": [1240, -100]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\nconst id = $('IF has video').item.json.message.video.file_id;\nconst dir = '/tmp/reels';\nconst transcript = fs.readFileSync(path.join(dir, `${id}.txt`), 'utf8');\nconst frameFiles = fs.readdirSync(dir).filter(f => f.startsWith(`${id}_f`) && f.endsWith('.jpg')).slice(0, 8);\nconst images = frameFiles.map(f => ({\n  inline_data: {\n    mime_type: 'image/jpeg',\n    data: fs.readFileSync(path.join(dir, f)).toString('base64')\n  }\n}));\nconst prompt = `Summarize this Instagram reel. Transcript: \"${transcript}\". Return JSON with keys title, key_points (array), key_activities (array).`;\nreturn [{ json: { id, requestBody: { contents: [{ parts: [{ text: prompt }, ...images] }] } } }];"
      },
      "id": "n9", "name": "Build multimodal prompt", "type": "n8n-nodes-base.code",
      "typeVersion": 2, "position": [1480, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-goog-api-key", "value": "={{ $credentials.geminiApi.apiKey }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}"
      },
      "id": "n10", "name": "Gemini vision call", "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2, "position": [1720, -100],
      "credentials": { "httpHeaderAuth": { "id": "", "name": "Gemini API" } }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "title", "type": "string", "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).title }}" },
            { "name": "key_points", "type": "array", "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).key_points }}" },
            { "name": "key_activities", "type": "array", "value": "={{ JSON.parse($json.candidates[0].content.parts[0].text).key_activities }}" }
          ]
        }
      },
      "id": "n11", "name": "Shape output", "type": "n8n-nodes-base.set",
      "typeVersion": 3.4, "position": [1960, -100]
    },
    {
      "parameters": {
        "resource": "message", "operation": "sendMessage",
        "chatId": "={{ $('IF has video').item.json.message.chat.id }}",
        "text": "=*{{ $json.title }}*\n\nKey points:\n{{ $json.key_points.map(p => '- ' + p).join('\\n') }}\n\nKey activities:\n{{ $json.key_activities.map(a => '- ' + a).join('\\n') }}"
      },
      "id": "n12", "name": "Reply with summary", "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2, "position": [2200, -100],
      "credentials": { "telegramApi": { "id": "", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "IF has video", "type": "main", "index": 0 }]] },
    "IF has video": {
      "main": [
        [{ "node": "Telegram getFile", "type": "main", "index": 0 }],
        [{ "node": "Reply - send a reel", "type": "main", "index": 0 }]
      ]
    },
    "Telegram getFile": { "main": [[{ "node": "yt-dlp download", "type": "main", "index": 0 }]] },
    "yt-dlp download": { "main": [[{ "node": "ffmpeg extract audio", "type": "main", "index": 0 }]] },
    "ffmpeg extract audio": { "main": [[{ "node": "whisper.cpp transcribe", "type": "main", "index": 0 }]] },
    "whisper.cpp transcribe": { "main": [[{ "node": "ffmpeg extract frames", "type": "main", "index": 0 }]] },
    "ffmpeg extract frames": { "main": [[{ "node": "Build multimodal prompt", "type": "main", "index": 0 }]] },
    "Build multimodal prompt": { "main": [[{ "node": "Gemini vision call", "type": "main", "index": 0 }]] },
    "Gemini vision call": { "main": [[{ "node": "Shape output", "type": "main", "index": 0 }]] },
    "Shape output": { "main": [[{ "node": "Reply with summary", "type": "main", "index": 0 }]] }
  }
}
